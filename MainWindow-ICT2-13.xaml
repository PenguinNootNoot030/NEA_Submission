<Window x:Class="Testing_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Testing_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Image HorizontalAlignment="Left" Height="218" Margin="38,25,0,0" VerticalAlignment="Top" Width="365" RenderTransformOrigin="-4.405,-0.395"/>
        <Button Content="Clear" HorizontalAlignment="Left" Margin="94,291,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.277,0.609" Height="34" Width="60" Click="Clear_Button_Click"/>
        <Button Content="Save" HorizontalAlignment="Left" Margin="286,291,0,0" VerticalAlignment="Top" Height="34" Width="60" RenderTransformOrigin="0.517,1.089" Click="Save_Button_Click"/>

        <TextBlock HorizontalAlignment="Left" Margin="468,32,0,0" TextWrapping="Wrap" Text="Mode" VerticalAlignment="Top"/>

        <ComboBox SelectedIndex="0" HorizontalAlignment="Left" Margin="525,29,0,0" VerticalAlignment="Top" Width="70" RenderTransformOrigin="-0.225,0.093" SelectionChanged="Mode_ComboBox_SelectionChanged">
            <ComboBoxItem Content="*" IsEnabled="False"/>
            <ComboBoxItem Content="Embed"/>
            <ComboBoxItem Content="Attack"/>
            <ComboBoxItem Content="Evaluate"/>
        </ComboBox>
        <ComboBox HorizontalAlignment="Left" Margin="664,29,0,0" VerticalAlignment="Top" Width="90" RenderTransformOrigin="-0.225,0.093" SelectionChanged="Option_ComboBox_SelectionChanged"/>
        
        <TextBlock HorizontalAlignment="Left" Margin="606,32,0,0" TextWrapping="Wrap" Text="Operation" VerticalAlignment="Top"/>
        
        <StackPanel/>



    </Grid>
</Window>
