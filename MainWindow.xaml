<Window x:Class="Testing_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Testing_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="AliceBlue">
    <Grid Margin="0,0,0,-6">

        <Image x:Name="MainPictureDisplay" HorizontalAlignment="Left" Height="260" Margin="38,18,0,0" VerticalAlignment="Top" Width="391" RenderTransformOrigin="-4.405,-0.395"/>

        <!--Buttons-->
        <Button x:Name="ClearButton" Content="Clear" HorizontalAlignment="Left" Margin="167,291,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.277,0.609" Height="34" Width="76" Click="Clear_Button_Click"/>

        <!--Combo Boxes-->
        <ComboBox x:Name="ModeSelect" HorizontalAlignment="Left" Margin="525,29,0,0" VerticalAlignment="Top" Width="109" RenderTransformOrigin="-0.225,0.093" SelectionChanged="ModeSelect_SelectionChanged">

            <ComboBoxItem Content="*" IsEnabled="False"/>
            <ComboBoxItem Content="Embed"/>
            <ComboBoxItem Content="Attack"/>
            <ComboBoxItem Content="Evaluate"/>
        </ComboBox>

        <ComboBox x:Name="OptionSelect" HorizontalAlignment="Left" Margin="664,29,0,0" VerticalAlignment="Top" Width="109" RenderTransformOrigin="-0.225,0.093" SelectionChanged="OptionSelect_SelectionChanged" />

        <!--Labels-->
        <Label Content="Mode" HorizontalAlignment="Left" Margin="438,25,0,0" VerticalAlignment="Top" Width="59" RenderTransformOrigin="0.61,0.618"/>

        <StackPanel x:Name="ParamArea" Orientation= "Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="260" Width="338" Margin="438,65,0,0" Background="Lavender"/>
        <Button x:Name="ApplyButton" Content="Apply" HorizontalAlignment="Left" Margin="698,277,0,0" VerticalAlignment="Top" Height="48" Width="75" Click="ApplyButton_Click"/>
        <Button x:Name="UploadButton" Content="Upload" HorizontalAlignment="Left" Margin="630,347,0,0" VerticalAlignment="Top" Height="34" Width="76" Click="UploadButton_Click"/>
        <TextBox x:Name="FilePath_TextBox" HorizontalAlignment="Left" Margin="106,353,0,0" TextWrapping="Wrap" Text="Please enter the image's file path..." VerticalAlignment="Top" Width="501" Height="19"/>
        <TextBlock HorizontalAlignment="Left" Margin="43,353,0,0" TextWrapping="Wrap" Text="File Path:" VerticalAlignment="Top"/>
    </Grid>
</Window>
